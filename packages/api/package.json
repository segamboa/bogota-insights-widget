{
  "name": "@bogota-insights/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist *.tsbuildinfo",
    "migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx src/services/ingest-runner.ts --all",
    "ingest:ideca": "tsx src/services/ingest-runner.ts --ideca",
    "ingest:transmilenio": "tsx src/services/ingest-runner.ts --transmilenio",
    "ingest:osm": "tsx src/services/ingest-runner.ts --osm"
  },
  "dependencies": {
    "@bogota-insights/shared": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@turf/turf": "^6.5.0",
    "dotenv": "^16.4.1",
    "fastify": "^4.25.2",
    "ioredis": "^5.3.2",
    "ngeohash": "^0.6.3",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.11.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1"
  }
}
