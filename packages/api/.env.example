# API Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/bogota_insights
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Data Sources
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
IDECA_API_URL=https://mapas.bogota.gov.co/api/
TRANSMILENIO_GTFS_URL=https://gis.transmilenio.gov.co/gtfs/

# CORS
CORS_ORIGIN=*

# Tier Rate Limits (requests per minute / per day)
TIER_FREE_PER_MINUTE=10
TIER_FREE_PER_DAY=500
TIER_STANDARD_PER_MINUTE=60
TIER_STANDARD_PER_DAY=10000
TIER_ENTERPRISE_PER_MINUTE=300
TIER_ENTERPRISE_PER_DAY=100000

# ETL Verification Thresholds (optional overrides)
ETL_TOTAL_POIS_MIN=20000
ETL_TOTAL_POIS_OPTIMAL=27000
ETL_TOTAL_POIS_CRITICAL=15000
ETL_IDECA_MIN=4000
ETL_OSM_MIN=12000
ETL_TRANSMILENIO_MIN=100
ETL_DATA_FRESHNESS_DAYS=30

# Geographic Bounds (optional — defaults to Bogotá)
# GEO_BOUNDS_NORTH=4.84
# GEO_BOUNDS_SOUTH=4.45
# GEO_BOUNDS_EAST=-73.88
# GEO_BOUNDS_WEST=-74.27

# API Keys (SHA-256 hashed)
# Generate with: echo -n "your-api-key" | shasum -a 256
