# API Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://user:password@localhost:5432/bogota_insights
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Data Sources
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
IDECA_API_URL=https://mapas.bogota.gov.co/api/
TRANSMILENIO_GTFS_URL=https://gis.transmilenio.gov.co/gtfs/

# CORS
CORS_ORIGIN=*

# API Keys (SHA-256 hashed)
# Generate with: echo -n "your-api-key" | shasum -a 256
